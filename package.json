    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "jose": "^6.2.12",
    "jsdom": "^29.0.0",
    "lighthouse": "13.5.0",
    "node-pty": "1.1.0",
    "postcss": "8.5.28",
    "postcss-value-parser": "4.2.0",
    "prettier": "3.9.9",
