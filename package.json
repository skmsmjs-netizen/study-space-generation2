{
  "name": "study-space-generation2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/build-recall-optimizer.mjs && vite --host 127.0.0.1",
    "build": "node scripts/build-recall-optimizer.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:backend": "node scripts/build-backend.mjs",
    "test:code-terminal": "node --test scripts/code-terminal.node-test.mjs",
    "check:design": "node scripts/check-design-tokens.mjs",
    "test:design": "node --test scripts/design-tokens.node-test.mjs",
    "predev": "npm run check:design",
    "prebuild": "npm run check:design",
    "pretest": "npm run test:design",
    "lint": "npm run check:design"
  },
  "dependencies": {
    "@repomix/tree-sitter-wasms": "0.1.17",
    "@supabase/supabase-js": "^2.117.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "^12.12.0",
    "d3-force": "^3.0.0",
    "fsrs-browser": "6.6.0",
    "lz-string": "1.5.0",
    "monaco-editor": "^0.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ts-fsrs": "5.4.2",
    "web-tree-sitter": "0.27.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "6.2.5",
    "jsdom": "^29.0.0",
    "node-pty": "1.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "ws": "8.22.0",
    "postcss": "8.5.28",
    "postcss-value-parser": "4.2.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
