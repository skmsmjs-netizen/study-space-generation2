{
  "name": "study-space-generation2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/prepare-material-tools.mjs && node scripts/prepare-math-tools.mjs && node scripts/build-recall-optimizer.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare-material-tools.mjs && node scripts/prepare-math-tools.mjs && node scripts/build-recall-optimizer.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:backend": "node scripts/build-backend.mjs",
    "storybook": "storybook dev --host 127.0.0.1 --port 6007 --no-open --disable-telemetry",
    "storybook:build": "storybook build --disable-telemetry",
    "storybook:serve": "vite preview --outDir storybook-static --host 127.0.0.1 --port 6007 --strictPort",
    "typecheck:tools": "tsc --project tsconfig.tooling.json --noEmit",
    "lint": "npm run check:design && biome lint src",
    "lint:tools": "biome lint .storybook e2e playwright.config.ts playwright.devices.config.ts src/ui/components.stories.tsx",
    "format": "prettier --write",
    "format:check": "prettier --check",
    "format:tools:check": "prettier --check .storybook e2e playwright.config.ts playwright.devices.config.ts tsconfig.tooling.json biome.json .prettierrc.json .vscode src/ui/components.stories.tsx .github/workflows/ui-tools.yml",
    "test:ui": "playwright test --project=chromium --project=webkit",
    "test:ui:open": "playwright test --ui",
    "test:ui:report": "playwright show-report",
    "audit:ui": "lighthouse http://127.0.0.1:6007/iframe.html?id=study-common-ui--field-states --only-categories=performance,accessibility,best-practices --chrome-flags=\"--headless\" --output=html --output=json --output-path=work/ui-tooling-20261001/lighthouse --quiet",
    "test:ui:all": "playwright test",
    "test:ui:firefox": "playwright test --project=firefox",
    "check:design": "node scripts/check-design-tokens.mjs",
    "test:design": "node --test scripts/design-tokens.node-test.mjs",
    "predev": "npm run check:design",
    "prebuild": "npm run check:design",
    "pretest": "npm run test:design",
    "setup:gpt-local": "node scripts/setup-local-gpt.mjs",
    "test:code-terminal": "node --test scripts/code-terminal.node-test.mjs",
    "prepare:math-tools": "node scripts/prepare-math-tools.mjs",
    "test:devices": "playwright test --config playwright.devices.config.ts"
  },
