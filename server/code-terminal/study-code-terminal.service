[Unit]
Description=Study interactive code terminal
After=network-online.target isolate.service
Requires=isolate.service
Wants=network-online.target

[Service]
Type=simple
User=study-terminal
Group=study-terminal
WorkingDirectory=/opt/study-code-terminal
EnvironmentFile=/etc/study-code-terminal.env
ExecStart=/usr/bin/node /opt/study-code-terminal/gateway.mjs
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=10
LimitNOFILE=4096
UMask=0077
ProtectHome=true
# isolate is a standard setuid sandbox; NoNewPrivileges would prevent it from working.
# No shell, Docker socket, host root, or private env is passed to user programs.

[Install]
WantedBy=multi-user.target
